APP_NAME=Leafmark
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Postgres aus docker-compose.yml (docker compose up -d db)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=leafmark
DB_USERNAME=leafmark
DB_PASSWORD=leafmark

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail-Versand wird zur Laufzeit aus Admin → System Settings konfiguriert.
# Lokal landen Mails im Log, solange dort kein SMTP aktiv ist.
MAIL_MAILER=log

# First user OR this address automatically becomes admin
ADMIN_EMAIL=
